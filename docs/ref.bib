@article{Shin_Seo_Jung_Kim_Kim_Kim_Jeong_2025,
    title         = {Carbon emission reduction scenarios in the building sector to achieve carbon neutrality in South Korea by 2050},
    volume        = {339},
    issn          = {03605442},
    doi           = {10.1016/j.energy.2025.139057},
    abstractnote  = {Countries worldwide are moving toward carbon neutrality, with the construction sector strengthening policies to achieve this by 2050 despite the existing challenges. In this study, we developed a model scenario to achieve carbon neutrality in the building sector in Korea by 2050. The results were analyzed with respect to the energy demand and supply, considering zero-energy buildings (ZEBs), green remodeling, and building electrification according to the energy mix. We determined that carbon emissions in 2050 are projected to be 6.1 MtCO2eq, which is close to the carbon-neutrality-scenario target of 6.2 MtCO2eq for the building sector. Based on the assumptions of ZEBs, building electrification, and energy mix scenarios, the projected target can be realized if the efficiency of green remodeling exceeds 40 \% after 2030. The results of this study can contribute to guiding the development of technologies and determining policy timelines for achieving carbon neutrality in buildings.},
    journal       = {Energy},
    author        = {Shin, Dae Hwan and Seo, Jihyun and Jung, Dong Eun and Kim, Sumin and Kim, Hyungjun and Kim, Jonghun and Jeong, Hakgeun},
    year          = {2025},
    month         = dec,
    pages         = {139057},
    language      = {en}
}
