# ultraplot settings
cycle:                tol:bright_alt
legend.borderaxespad: 1
legend.edgecolor:     0.6
legend.fontsize:      small
subplots.refwidth:    8cm
tick.dir:             in

# Matplotlib settings
font.family:          sans-serif
font.serif:           Noto Sans Serif, Source Han Serif KR, DejaVu Serif
font.sans-serif:      Noto Sans KR, Source Han Sans KR, DejaVu Sans

mathtext.fontset:     cm
mathtext.default:     normal
