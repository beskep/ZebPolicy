# ultraplot settings
cycle:                tol:bright_alt
legend.borderaxespad: 1
legend.edgecolor:     0.6
legend.fontsize:      small
subplots.refwidth:    8cm
tick.dir:             in

# Matplotlib settings
font.family:          sans-serif
font.sans-serif:      Noto Sans KR, Source Han Sans KR, sans-serif
font.serif:           Noto Sans Serif, Source Han Serif KR, serif
font.cursive:         Apple Chancery, Textile, Zapf Chancery, Sand, Script MT, Felipa, Comic Neue, Comic Sans MS, cursive

mathtext.fontset:     cm
mathtext.default:     normal
